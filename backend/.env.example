PORT=4000
JWT_SECRET=cambiar_este_secreto_en_produccion
DB_PATH=./db/barberia.db

# Dominios del frontend habilitados, separados por comas.
# El Vite local (5173) ya está permitido siempre.
ORIGENES_PERMITIDOS=

# Base pública del frontend, para armar los enlaces de recuperación
URL_APP=http://localhost:5173

# Notificaciones push (Web Push). Generar el par con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:hola@barberia93cuartos.com
